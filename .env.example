# --- Database (MySQL — cPanel's MySQL Databases tool on Namecheap) ---
# Create a database and a DB user in cPanel first (they'll be prefixed
# with your cPanel username, e.g. "cpuser_shoepilot" / "cpuser_dbuser").
# Since the app and database run on the same host, "localhost" works.
DATABASE_URL="mysql://cpuser_dbuser:password@localhost:3306/cpuser_shoepilot"

# --- Site URL (used to build verification links and NOWPayments callback URLs) ---
# Use http://localhost:3000 for local dev. In production, set this to:
NEXTAUTH_URL="https://blackjack.us"

# --- NOWPayments ---
# Sign up at https://nowpayments.io, get API key from your dashboard
NOWPAYMENTS_API_KEY="your-nowpayments-api-key"
# Set an IPN secret in NOWPayments settings -> used to verify webhook signatures
NOWPAYMENTS_IPN_SECRET="your-ipn-secret"

# --- File storage (local disk — no setup needed on Namecheap) ---
# Release files live under ./local-releases/ and are served via DB-backed
# tokens in /api/local-download/[token]. Back up that folder yourself.

# --- Admin dashboard (/admin) ---
# One shared password gates the whole admin area — see src/lib/admin-auth.ts.
# Generate ADMIN_SESSION_SECRET with: openssl rand -base64 32
ADMIN_PASSWORD="choose-a-strong-password"
ADMIN_SESSION_SECRET="replace-with-a-random-32-byte-secret"

# --- Email (SMTP — the mailbox that comes free with Namecheap hosting) ---
# cPanel -> Email Accounts -> create e.g. licenses@blackjack.us, then use
# its settings here (cPanel's "Connect Devices" page for that mailbox
# shows the exact host/port). Typically:
#   SMTP_HOST = mail.blackjack.us (or the "Private" host cPanel shows you)
#   SMTP_PORT = 465 with SMTP_SECURE=true, or 587 with SMTP_SECURE=false
SMTP_HOST="mail.blackjack.us"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="licenses@blackjack.us"
SMTP_PASSWORD="the mailbox's password"
EMAIL_FROM="licenses@blackjack.us"

# --- Pricing / trial ---
PRODUCT_PRICE_USD="49.00"
TRIAL_DAYS="3"
