# --- Database (PRODUCTION - business93, StellarBus18, MariaDB 11.4.13) ---
# cPanel user betshtmk, DB already created. Host is localhost (same box).
DATABASE_URL="mysql://betshtmk_shoepilot:betshtmk_shoepilot@localhost:3306/betshtmk_shoepilot"

# --- Site URL (PRODUCTION) ---
NEXTAUTH_URL="https://blackjacklab.us"

# --- NOWPayments (PRODUCTION - https://nowpayments.io dashboard) ---
# IPN callback must be: https://blackjacklab.us/api/payments/nowpayments/webhook
# Which coins customers can pick is set in your NOWPayments dashboard
# (Store settings -> Coin settings), NOT in code.
# Optional: "true" makes the buyer pay NOWPayments' service fee on top of the
# price so you receive the full amount. Default is off.
NOWPAYMENTS_API_KEY="PASTE-nowpayments-api-key-here"
NOWPAYMENTS_IPN_SECRET="PASTE-ipn-secret-here"
NOWPAYMENTS_FEE_PAID_BY_USER="false"

# --- File storage (local disk — no setup needed on Namecheap) ---
# Release files live under ./local-releases/ and are served via DB-backed
# tokens in /api/local-download/[token]. Back up that folder yourself.

# --- Admin dashboard (/admin) ---
# Generate ADMIN_SESSION_SECRET with: openssl rand -base64 32
ADMIN_PASSWORD="PASTE-strong-password-here"
ADMIN_SESSION_SECRET="PASTE-openssl-rand-output-here"

# --- Hosted app (/app) ---
# Signs the short-lived tokens the app uses to ask the server for decisions.
# Optional: if unset, ADMIN_SESSION_SECRET is used instead. Generate with:
#   openssl rand -base64 32
# Add this key in cPanel Node env too when you set it here.
APP_SESSION_SECRET="PASTE-another-random-32-byte-secret-here"

# --- Email (PRODUCTION - local sendmail, no config needed) ---
# Leave SMTP_* unset and mail goes out through /usr/sbin/sendmail from
# EMAIL_FROM (must be an address on your own domain). Set SMTP_HOST to
# route through an external SMTP server instead.
# (SMTP_HOST="business93.web-hosting.com" with the mailbox below worked
# here too, but the jail's DNS/TLS made it flaky — sendmail is steadier.)
#SMTP_HOST="business93.web-hosting.com"
#SMTP_PORT="465"
#SMTP_SECURE="true"
#SMTP_USER="licenses@blackjacklab.us"
#SMTP_PASSWORD="mailbox password here"
EMAIL_FROM="licenses@blackjacklab.us"

# --- Pricing / trial ---
# The price actually charged at checkout (server side, read live from cPanel env):
PRODUCT_PRICE_USD="19.99"
# The price DISPLAYED on the checkout page (baked in at build time by GitHub
# workflow, so it needs a rebuild to change). Keep identical to PRODUCT_PRICE_USD.
NEXT_PUBLIC_PRODUCT_PRICE_USD="19.99"
TRIAL_DAYS="3"
